{
  "manifest_version": "0.2",
  "name": "doorloop-mcp",
  "display_name": "DoorLoop",
  "version": "0.1.0",
  "description": "Read and manage DoorLoop properties, units, tenants, leases and balances.",
  "author": { "name": "Rico" },
  "server": {
    "type": "node",
    "entry_point": "dist/index.js",
    "mcp_config": {
      "command": "node",
      "args": ["${__dirname}/dist/index.js"],
      "env": { "DOORLOOP_API_KEY": "${user_config.api_key}" }
    }
  },
  "user_config": {
    "api_key": {
      "type": "string",
      "title": "DoorLoop API key",
      "description": "Create one in DoorLoop under Settings > Zapier & API Keys. Stored in your OS keychain.",
      "sensitive": true,
      "required": true
    }
  },
  "tools": [
    { "name": "whoami", "description": "Check the connection and show the key's owner" },
    { "name": "list_properties", "description": "List properties" },
    { "name": "get_property", "description": "Get one property" },
    { "name": "list_units", "description": "List units" },
    { "name": "get_unit", "description": "Get one unit" },
    { "name": "list_tenants", "description": "List tenants" },
    { "name": "get_tenant", "description": "Get one tenant" },
    { "name": "list_leases", "description": "List leases" },
    { "name": "get_lease", "description": "Get one lease" },
    { "name": "get_rent_roll", "description": "Rent roll with balances" },
    { "name": "doorloop_get", "description": "Read-only GET on any DoorLoop path" }
  ]
}
